# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=your-bot-token-here

# Application (Client) ID from the "General Information" tab of your app
CLIENT_ID=your-application-client-id

# From console.upstash.com -> your database -> REST API section.
# Required for tracked users/watchlists/recommendations to survive
# restarts and redeploys. If left blank, the bot falls back to a local
# file that does NOT survive a Render redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: put a Discord server ID here while testing so slash commands
# register instantly in that one server. Leave blank for global commands
# (those can take up to an hour to show up everywhere, but work in any server).
GUILD_ID=

# How often (in minutes) the bot checks AniList for new activity
POLL_MINUTES=3

# ---- Developer Dashboard (served at /dashboard on your bot's URL) ----

# Required. The single shared password used to log into the dashboard.
# Pick something long/random - this protects sending messages, pausing
# the bot, and triggering redeploys.
DASHBOARD_PASSWORD=

# Required for logins to survive a restart. Any long random string -
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=

# Optional but needed for the "Redeploy" button to work. On Render:
# your service -> Settings -> Deploy Hook -> copy the URL.
RENDER_DEPLOY_HOOK_URL=

# Optional. Discord channel ID the dashboard's Feedback tab reads from (the
# channel your feedback webhook posts submissions into). Defaults to the
# AniTracker Feedback webhook's channel if left blank.
FEEDBACK_CHANNEL_ID=
