# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=your-bot-token-here

# Application (Client) ID from the "General Information" tab of your app
CLIENT_ID=your-application-client-id

# Optional: put a Discord server ID here while testing so slash commands
# register instantly in that one server. Leave blank for global commands
# (those can take up to an hour to show up everywhere, but work in any server).
GUILD_ID=

# How often (in minutes) the bot checks AniList for new activity
POLL_MINUTES=3
